{
  "expo": {
    "name": "BijliOptima",
    "slug": "bijlioptima",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090D14",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bijlioptima.app"
    },
    "android": {
      "package": "com.bijlioptima.app",
      "adaptiveIcon": {
        "backgroundColor": "#090D14",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BijliOptima to access your camera to scan electricity bills."
        }
      ]
    ]
  }
}
